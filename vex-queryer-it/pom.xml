<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.vex</groupId>
        <artifactId>vex-queryer-parent</artifactId>
        <version>1.1.0</version>
        <relativePath>..</relativePath>
    </parent>

    <artifactId>vex-queryer-it</artifactId>
    <packaging>jar</packaging>
    <name>Vex Queryer IT</name>
    <description>
        集成测试模块 — 用真实 PostgreSQL 验证查询执行器的 SQL 生成与执行。
        本模块只跑测试,不打可发布 jar。
    </description>

    <properties>
        <!-- Testcontainers 版本;2.x 用 docker-java 3.7,支持 Docker 29.x 的 API 1.40+,
             1.21.x 内置的旧 docker-java 与 Docker 29 协商失败(400 BadRequest) -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <!-- 无 Docker 环境时跳过集成测试 -->
        <skipITs>false</skipITs>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.vex</groupId>
            <artifactId>vex-queryer-jpa</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.vex</groupId>
            <artifactId>vex-queryer-model</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot 测试基础设施 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers PostgreSQL — 必须真实 PG:exp 操作符用 PG 15+ 的 regexp_like,方言不对就跑不通 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- PostgreSQL 驱动 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 产物不发布;仅测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <skipIfEmpty>true</skipIfEmpty>
                </configuration>
            </plugin>

            <!-- 本模块不产出可发布构件,install/deploy 无意义 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>

            <!-- 集成测试固定使用 *IT 命名,由 failsafe 在 verify 阶段跑,不阻塞 mvn test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <skipITs>${skipITs}</skipITs>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>